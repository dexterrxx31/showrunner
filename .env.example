# Channel epoch: the instant the channel "went on air" (must be in the past)
SHOWRUNNER_EPOCH=2026-01-01T00:00:00+00:00

# Live window size (segments per manifest)
SHOWRUNNER_WINDOW=5

# Manifest cache TTL in seconds
SHOWRUNNER_MANIFEST_TTL=1.0

# --- Phase 2: ingest & catalog ---
# Database (SQLite by default; Postgres in production)
# SHOWRUNNER_DB=postgresql+psycopg://showrunner:showrunner@localhost:5432/showrunner
# Channel catalog source: "json" (demo file) or "db" (ingested assets)
SHOWRUNNER_CATALOG_SOURCE=json
# Segment storage: "local" or "s3"
SHOWRUNNER_STORAGE=local
# SHOWRUNNER_S3_ENDPOINT=http://localhost:9000
# SHOWRUNNER_S3_ACCESS_KEY=showrunner
# SHOWRUNNER_S3_SECRET_KEY=showrunner
# Task queue: leave empty for in-process ingest, or set a Celery broker
# SHOWRUNNER_BROKER=redis://localhost:6379/0

# Access control: when set, POST/PUT/PATCH/DELETE require this key
# (X-API-Key or Authorization: Bearer). Leave unset only on localhost.
# SHOWRUNNER_API_KEY=change-me
# Comma-separated browser origins allowed by CORS (default: *)
# SHOWRUNNER_CORS_ORIGINS=https://example.com

# Phase 6: AI programming director. Pick a provider per request
# ("provider": "anthropic" | "google" | "groq" | "meta") and set its credentials.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# Llama (Meta) via any OpenAI-compatible host; defaults to local Ollama
# LLAMA_BASE_URL=http://localhost:11434/v1
# LLAMA_API_KEY=ollama
# Optional per-provider default model overrides
# ANTHROPIC_MODEL=
# GEMINI_MODEL=
# GROQ_MODEL=
# LLAMA_MODEL=
